      "stem": "请选出画线词语的汉语拼音。\n这件上衣穿起来真好看，很++适合++你。",
      "options": [
        "sì hè",
        "sī hè",
        "shī hé",
        "shì hé"
      ],
      "parts": [
        {
          "label": "",
          "answer": {
            "type": "mcq",
            "value": 4
          },
          "explanation": [
            "“适”是翘舌音 shì，读第四声，不是平舌音 sì。",
            "“合”读第二声 hé，不是第四声 hè。",
            "“适合”读 shì hé，答案是（4）。"
          ]
        }
      ],
      "review": {
        "keyAnswer": "4",
        "solvedAnswer": "4",
        "status": "verified"
      }
    },
