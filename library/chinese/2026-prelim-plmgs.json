      "stem": "请选出画线词语的汉语拼音。\n我会++加倍++珍惜妈妈亲手给我做的被子。",
      "options": [
        "jiá bèi",
        "jiā bèi",
        "jiá péi",
        "jiā pèi"
      ],
      "parts": [
        {
          "label": "",
          "answer": {
            "type": "mcq",
            "value": 2
          },
          "explanation": [
            "“加”读第一声 jiā，不是第二声 jiá。",
            "“倍”的声母是 b，读 bèi；“陪 péi”“配 pèi”的声母才是 p。",
            "“加倍”读 jiā bèi，答案是（2）。"
          ]
        }
      ],
      "review": {
        "keyAnswer": "2",
        "solvedAnswer": "2",
        "status": "verified"
      }
    },
