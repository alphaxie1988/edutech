      "subtypes": [
        "pinyin"
      ],
      "stem": "请选出画线词语的汉语拼音。\n小明非常++珍惜++时间，一有空就阅读各种课外书，充实自己。",
      "options": [
        "zhēn xī",
        "zhèn xí",
        "zhēng xī",
        "zhèng xí"
      ],
      "parts": [
        {
          "label": "",
          "answer": {
            "type": "mcq",
            "value": 1
          },
          "explanation": [
            "“珍”是前鼻音 zhēn，不是后鼻音 zhēng。",
            "“惜”读第一声 xī，不是第二声 xí。",
            "“珍惜”读 zhēn xī，答案是（1）。"
          ]
        }
      ],
      "review": {
        "keyAnswer": "1",
        "solvedAnswer": "1",
        "status": "verified"
      }
    },
