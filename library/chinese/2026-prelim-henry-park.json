      "stem": "请选出画线词语的汉语拼音。\n大家对他助人为乐的行为连声++称赞++。",
      "options": [
        "chēn zān",
        "chēn zàn",
        "chēng zàn",
        "chēng zān"
      ],
      "parts": [
        {
          "label": "",
          "answer": {
            "type": "mcq",
            "value": 3
          },
          "explanation": [
            "“称”是后鼻音 chēng，不是前鼻音 chēn。",
            "“赞”读第四声 zàn，不是第一声 zān。",
            "“称赞”读 chēng zàn，答案是（3）。"
          ]
        }
      ],
      "review": {
        "keyAnswer": "3",
        "solvedAnswer": "3",
        "status": "verified"
      }
    },
