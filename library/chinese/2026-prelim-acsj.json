      "stem": "请选出画线词语的汉语拼音。\n外婆++临时++决定今晚不出去吃饭了。",
      "options": [
        "lín shí",
        "lín shǐ",
        "líng shí",
        "líng shǐ"
      ],
      "parts": [
        {
          "label": "",
          "answer": {
            "type": "mcq",
            "value": 1
          },
          "explanation": [
            "“临”是前鼻音 lín，不是后鼻音 líng。",
            "“时”读第二声 shí，不是第三声 shǐ。",
            "“临时”读 lín shí，答案是（1）。"
          ]
        }
      ],
      "review": {
        "keyAnswer": "1",
        "solvedAnswer": "1",
        "status": "verified"
      }
    },
